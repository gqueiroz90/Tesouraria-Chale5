rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
          'gabrielcostadequeiroz@gmail.com',
          'beatrizma8@gmail.com',
          'arturhenrique722@gmail.com',
          'pradoleo92@gmail.com',
          'thiagocardoso2505@gmail.com',
          'jonathassgoncalves@gmail.com'
          'marlonfernandesfranco@gmail.com'
        ]
        && request.auth.token.email_verified == true;
    }

    function validExpense() {
      return request.resource.data.keys().hasOnly(['description', 'category', 'amount', 'date'])
        && request.resource.data.keys().hasAll(['description', 'category', 'amount', 'date'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 160
        && request.resource.data.category in ['aluguel', 'agua', 'luz', 'caixa', 'outros']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /expenses/{expenseId} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validExpense();
    }

    function validBooking() {
      return request.resource.data.keys().hasOnly(['kind', 'name', 'checkIn', 'checkOut', 'amount', 'note'])
        && request.resource.data.keys().hasAll(['kind', 'name', 'checkIn', 'checkOut', 'amount', 'note'])
        && request.resource.data.kind in ['locacao', 'uso']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.checkIn is string
        && request.resource.data.checkIn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.checkOut is string
        && request.resource.data.checkOut.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.checkOut > request.resource.data.checkIn
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200;
    }

    function validCashExpense() {
      return request.resource.data.keys().hasOnly(['description', 'category', 'amount', 'date'])
        && request.resource.data.keys().hasAll(['description', 'category', 'amount', 'date'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 160
        && request.resource.data.category in ['manutencao', 'melhorias', 'reposicao', 'outros']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /reservas/{bookingId} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validBooking();
    }

    match /gastosCaixa/{spendingId} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validCashExpense();
    }

    function validDeposit() {
      return request.resource.data.keys().hasOnly(['description', 'amount', 'date'])
        && request.resource.data.keys().hasAll(['description', 'amount', 'date'])
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 160
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /aportes/{depositId} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validDeposit();
    }
  }
}